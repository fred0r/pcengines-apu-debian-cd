#!/bin/sh

CLEAN=0
PROFILE=

while [ $# -gt 0 ]; do
    case "$1" in
        --clean|-c) CLEAN=1 ;;
        *) PROFILE=$1 ;;
    esac
    shift
done

if [ x${PROFILE} = x ]; then
    echo "Usage: $0 [--clean] PROFILE" 1>&2;
    exit 1
fi

if [ ! -e profiles/${PROFILE}.conf ]; then
    echo "Unknown profile: ${PROFILE}" 1>&2;
    exit 1
fi

OSCODE=`lsb_release -c 2>/dev/null | awk '{print $2}'`

if [ x${OSCODE} = x ] && [ -r /etc/os-release ]; then
    OSCODE=`awk -F= '/^VERSION_CODENAME=/{gsub(/"/, "", $2); print $2}' /etc/os-release`
fi

if [ x${OSCODE} = x ]; then
    echo "Cannot determine OS codename" 1>&2;
    exit 1
fi

# Keep the (expensive) local Debian mirror outside tmp/, so it survives
# "rm -rf tmp" and is reused across builds. Only the debian-cd working tree
# is rebuilt on each run; simple-cdd skips already-downloaded files (checksum
# match) and updates the mirror incrementally.
CACHE_BASE="${PCENGINES_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/pcengines-apu}"
CACHE_DIR="${CACHE_BASE}/${OSCODE}-amd64"
MIRROR_CACHE="${CACHE_DIR}/mirror"

if [ "${CLEAN}" = 1 ]; then
    echo "Cleaning tmp/ and mirror cache (${CACHE_DIR})..." 1>&2
    rm -rf tmp "${CACHE_DIR}"
fi

# One-time migration: seed the cache from an existing tmp/mirror so the first
# build after this change does not re-download everything.
if [ ! -e "${MIRROR_CACHE}" ] && [ -d tmp/mirror ]; then
    mkdir -p "${CACHE_DIR}"
    mv tmp/mirror "${MIRROR_CACHE}"
fi

simple_cdd_mirror="${MIRROR_CACHE}"
MIRROR="${MIRROR_CACHE}"
export simple_cdd_mirror MIRROR

# simple-cdd 0.6.9 (shipped in Debian trixie) unconditionally mirrors the
# i386 installer for amd64 builds, and expects the 32-bit UEFI boot files
# from it. Trixie dropped the i386 installer, so the build fails with a 404
# on dists/trixie/main/installer-i386. Both issues are fixed in simple-cdd
# 0.6.10; work around them here until the build host is upgraded.
case "${OSCODE}" in
    trixie|forky|sid)
        BUILD_SIMPLE_CDD=`command -v build-simple-cdd 2>/dev/null`
        if [ -n "${BUILD_SIMPLE_CDD}" ] && \
           grep -q -F 'if a == "amd64" and "i386" not in self.env.get("ARCHES"):' "${BUILD_SIMPLE_CDD}"; then
            mkdir -p tmp/bin
            sed 's/if a == "amd64" and "i386" not in self.env.get("ARCHES"):/if False and a == "amd64" and "i386" not in self.env.get("ARCHES"):/' \
                "${BUILD_SIMPLE_CDD}" > tmp/bin/build-simple-cdd
            chmod 755 tmp/bin/build-simple-cdd
            PATH="`pwd`/tmp/bin:${PATH}"
            export PATH
            # debian-cd can no longer obtain 32-bit UEFI files from the
            # i386 installer; disable them for trixie and newer.
            DISABLE_UEFI_32=1
            export DISABLE_UEFI_32
            echo "simple-cdd trixie workaround applied (skipping i386 installer, DISABLE_UEFI_32=1)." 1>&2
        fi
        ;;
esac

if [ `id -u` -eq 0 ]; then
    ROOT_CMDOPTS='--force-root'
else
    ROOT_CMDOPTS=''
fi

if [ -e profiles/default.preseed ]; then
    rm -f profiles/default.preseed
fi

if [ -e profiles/${PROFILE}.prerun ]; then
   profiles/${PROFILE}.prerun
   if [ $? -ne 0 ]; then
       echo "profiles/${PROFILE}.prerun returned error. Aborting" 1>&2
       exit 1
   fi
fi

# Always target amd64, regardless of the build host architecture. The
# profile .conf is read after the environment, so it still takes precedence.
ARCH=amd64
ARCHES=amd64
export ARCH ARCHES

build-simple-cdd --conf profiles/${PROFILE}.conf \
    --dist ${OSCODE} ${ROOT_CMDOPTS}

   

   
